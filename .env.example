# =============================================================================
# AI Shorts System — Environment Variables
# =============================================================================

# --- Azure OpenAI (PRIMARY) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Provider Selection ---
AI_PROVIDER=azure_openai
VOICE_PROVIDER=azure_openai

# --- Azure AI Speech (same Azure resource can often be reused) ---
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_VOICE=en-US-JennyNeural

# --- OpenAI Fallback ---
OPENAI_API_KEY=

# --- ElevenLabs ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Azure TTS (gpt-4o-mini-tts — separate resource) ---
AZURE_OPENAI_TTS_ENDPOINT=https://ethic-mo448h9b-eastus2.cognitiveservices.azure.com
AZURE_OPENAI_TTS_API_KEY=
AZURE_OPENAI_TTS_API_VERSION=2025-03-01-preview
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts
AZURE_OPENAI_TTS_VOICE=alloy

# --- MAI-Voice-1 (Azure AI Foundry) ---
MAI_VOICE_ENDPOINT=
MAI_VOICE_API_KEY=
MAI_VOICE_NAME=MAI-Voice-1

# --- Voicebox (local TTS) ---
# Local desktop usage: http://localhost:17493
# Docker Compose usage: http://voicebox:17493
VOICEBOX_URL=http://localhost:17493
VOICEBOX_PROFILE_ID=
VOICEBOX_ENGINE=qwen

# --- Kokoro (native local TTS) ---
KOKORO_MODEL_DIR=/app/data/kokoro
KOKORO_VOICE=af_sky

# --- Pexels (stock video search) ---
PEXELS_API_KEY=

# --- D-ID (avatar video generation) ---
DID_API_KEY=

# --- App ---
APP_NAME=AI Shorts System
DEBUG=false
SECRET_KEY=change-me-to-a-random-string

# --- n8n ---
N8N_WEBHOOK_URL=

# --- Google OAuth (get credentials at console.cloud.google.com) ---
# Create an OAuth 2.0 Client ID → Web application
# Authorised redirect URI: https://video.theadityashah.com/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=ethicaladitya@gmail.com
BASE_URL=https://video.theadityashah.com

# --- Ports (auto-detected, override if needed) ---
UI_PORT=8787
API_PORT=8788
N8N_PORT=8789

# =============================================================================
# UGC Video Engine — Local-first short-form video generation
# All local providers are FREE. Paid providers are opt-in fallbacks.
# Dashboard: https://videos.adityashah.blog/ugc/
# =============================================================================

# --- Provider preset: free | balanced | quality ---
# free      → all local (ollama + a1111/comfyui + kokoro + sadtalker)
# balanced  → local script+voice, azure_gpt_image, local head
# quality   → azure_openai + azure_gpt_image + elevenlabs + did
UGC_MODE=free

# --- Individual provider overrides (leave blank to use UGC_MODE preset) ---
# UGC_SCRIPT_PROVIDER=ollama       # ollama | azure_openai
# UGC_IMAGE_PROVIDER=a1111         # a1111 | comfyui | azure_gpt_image
# UGC_VOICE_PROVIDER=kokoro        # kokoro | elevenlabs | azure_tts | voicebox
# UGC_HEAD_PROVIDER=sadtalker      # sadtalker | slideshow | replicate | did

# --- Local service endpoints ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
COMFYUI_BASE_URL=http://localhost:8188
# COMFYUI_WORKFLOW_PATH=           # optional: path to custom workflow .json with IP-Adapter

# --- Local SadTalker CLI ---
# Install: https://github.com/OpenTalker/SadTalker
# SADTALKER_CLI_PATH=              # e.g. /opt/homebrew/bin/sadtalker

# --- Approval behaviour ---
# cli     → interactive terminal prompt (default; pipeline pauses for review)
# auto    → always approve (for batch/automated runs)
# webhook → waits for POST /ugc/jobs/{id}/approve from web UI
UGC_APPROVAL_MODE=cli

# --- Output paths (Docker defaults — override for local dev) ---
# UGC_OUTPUT_DIR=./output/ugc-videos
# UGC_TEMP_DIR=./temp/ugc-jobs

# --- Optional paid fallbacks (reuse keys already defined above) ---
# ELEVENLABS_API_KEY and ELEVENLABS_VOICE_ID — already defined above
# DID_API_KEY — already defined above
# REPLICATE_API_KEY and REPLICATE_SADTALKER_VERSION — already defined above